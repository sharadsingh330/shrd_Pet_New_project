# Pawlift Java backend configuration.
# These are read with System.getenv() (or -D system properties) by DatabaseConfig / CorsFilter.
# Never commit real passwords.

# JDBC URL of your MySQL 8 database
DB_URL=jdbc:mysql://localhost:3306/pawlift?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# MySQL user and password
DB_USER=pawlift_user
DB_PASSWORD=change_me

# Optional: comma-separated React origins allowed to call the API with cookies
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081
